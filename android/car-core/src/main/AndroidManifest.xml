<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!--
          AA-00 PROVISIONAL CATEGORY ONLY.

          androidx.car.app.category.IOT is used by the unified field app plus
          the carProto / automotive compatibility artifacts for the read-only
          vehicle-monitoring experience.

          This module is shared by the unified field app and the isolated
          carProto compatibility flavor. It MUST NOT be a dependency of
          rig/wear.
        -->
        <service
            android:name="com.cbstudio.telltale.car.TelltaleCarAppService"
            android:exported="true"
            android:label="@string/car_app_name">

            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
    </application>

</manifest>
