  "schema_version": 1,
  "contract_id": "ws07-privacy-data-flow-contract",
  "audited_base_sha": "4c7d0b5a57ea95f612e591e3203db6095de0b218",
  "policy_ref": "docs/privacy/public-artifact-policy.json",
  "policy_documents": [
    "PRIVACY.md",
    "docs/privacy.html"
  ],
  "claims": {
    "CLAIM-DEVELOPER-NO-COLLECTION": "The developer does not collect personal data, operates no remote backend servers, and requires no user accounts.",
    "CLAIM-LOCAL-STORAGE-PARTITION": "All app data is strictly written to local private device storage, segregated across SharedPreferences, Documents, and Application Cache.",
    "CLAIM-DIAGNOSTIC-RAW-BYTES": "Diagnostic transcript records raw OBD-II protocol exchanges including reported VIN and DTCs, stored in Documents/last-session.log, exported only upon explicit user request.",
    "CLAIM-TELEMETRY-NDJSON": "Telemetry sessions are stored locally in Documents/telltale-telemetry/<id>.ndjson; user may inspect, replay, export (CSV/JSON), or delete records locally. Structured fields exclude VIN, GPS, accounts; user-authored labels and notes are preserved.",
    "CLAIM-SHARE-CACHE-LIFECYCLE": "Staged share artifacts reside in Application Cache/telltale-app-shares/ with 15-minute eligibility and 24-hour due timestamps, cleaned during app launch and share flows.",
    "CLAIM-USER-CONTROLLED-SHARE": "Five formal export types (rawTranscript, recoveredTranscript, telemetryCsv, telemetryJson, pidCsv) require explicit user action. Zero pre-action handoff. Local deletion cannot recall copies handed to external apps.",
    "CLAIM-NETWORK-ADAPTER-ONLY": "INTERNET permission is utilized solely for opening a TCP socket to a user-configured Wi-Fi adapter (typically local 192.168.0.10:35000); destination endpoints depend on user settings; app has no built-in developer data collection or telemetry upload services.",
    "CLAIM-EXTERNAL-AFFILIATE-LINKS": "Recommended adapter links are affiliate listings opened via system launcher only upon explicit tap; zero telemetry, VIN, or device identity appended.",
    "CLAIM-PERMISSIONS-MINIMAL": "Declares only required permissions: BLUETOOTH_CONNECT, BLUETOOTH_SCAN (neverForLocation), legacy location (Android <=30), and INTERNET (Wi-Fi adapter). BLUETOOTH_ADVERTISE is stripped.",
    "CLAIM-NO-THIRD-PARTY-SDKS": "App contains zero analytics, advertising, crash reporting, or user tracking SDKs.",
    "CLAIM-OS-BACKUP-BEHAVIOR": "Operating system backups (Android Cloud/D2D, iOS/macOS system backups) may copy app private files depending on user device settings. Uninstalling removes local files but not preexisting OS backups.",
    "CLAIM-OPEN-SOURCE-VERIFIABLE": "Telltale is licensed under GPL-3.0; all privacy declarations are fully verifiable in public source code."
  },
